# Bắt buộc
# One or more OpenRouter keys, separated by commas. Spaces around commas are ignored.
OPENROUTER_API_KEY=
# Model hỗ trợ native tool calling, ví dụ tên model của provider bạn dùng
MODEL_NAME=
# Tùy chọn: endpoint OpenAI-compatible khác (mặc định https://openrouter.ai/api/v1).
OPENROUTER_BASE_URL=
